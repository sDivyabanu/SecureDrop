// use prisma-next

enum DownloadStatus {
  @@type("pg/text@1")
  SUCCESS                = "SUCCESS"
  INVALID_PASSWORD       = "INVALID_PASSWORD"
  EXPIRED                = "EXPIRED"
  DOWNLOAD_LIMIT_REACHED = "DOWNLOAD_LIMIT_REACHED"
  REVOKED                = "REVOKED"
  INTEGRITY_FAILED       = "INTEGRITY_FAILED"
}

model User {
  id           Int      @id @default(autoincrement())
  name         String?
  email        String   @unique
  passwordHash String
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  files File[]
}

model File {
  id           Int      @id @default(autoincrement())
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId      Int
  originalName String
  storageKey   String   @unique
  mimeType     String
  size         BigInt

  // AES-256-GCM encryption metadata (base64-encoded). Required to derive the
  // per-file key and to decrypt/verify the stored ciphertext. Application
  // code always supplies real values on insert; the "" default exists only
  // so this column can be added additively (no backfill of real data is
  // possible for a schema migration, and none is needed on an empty table).
  encryptionSalt    String @default("")
  encryptionIv      String @default("")
  encryptionAuthTag String @default("")
  keyVersion        Int    @default(1)

  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  shareLinks   ShareLink[]
  downloadLogs DownloadLog[]

  @@index([ownerId])
}

model ShareLink {
  id              Int      @id @default(autoincrement())
  file            File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  fileId          Int
  tokenHash       String   @unique
  passwordHash    String?
  expiresAt       TimestamptzString?
  maxDownloads    Int?
  downloadCount   Int      @default(0)
  oneTimeDownload Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       TimestamptzString @default(now())

  downloadLogs DownloadLog[]
  rateLimits   ShareRateLimit[]

  @@index([fileId])
  @@index([isActive])
  @@index([expiresAt])
}

// Fixed-window rate-limit counter for password attempts on a share link.
// One row per (shareLink, requester) pair — not one row per attempt — so
// repeated guesses from the same requester against the same link update a
// single row in place instead of growing the table without bound. Growth is
// bounded by the number of distinct (shareLink, requester) pairs that have
// ever attempted a password, not by request volume.
model ShareRateLimit {
  id           Int       @id @default(autoincrement())
  shareLink    ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
  shareLinkId  Int
  // SHA-256 hash of the requester's IP address (never stored raw).
  identifier   String
  attemptCount Int       @default(1)
  windowStart  TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  @@unique([shareLinkId, identifier])
}

model DownloadLog {
  id          Int            @id @default(autoincrement())
  file        File           @relation(fields: [fileId], references: [id], onDelete: Cascade)
  fileId      Int
  shareLink   ShareLink      @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
  shareLinkId Int
  status      DownloadStatus
  createdAt   TimestamptzString @default(now())

  @@index([fileId])
  @@index([shareLinkId])
  @@index([createdAt])
}
