# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Authentication (Auth.js / NextAuth v5)
# Secret used to sign session JWTs and CSRF tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# File Storage
# Local filesystem path where encrypted file objects are written in
# development (used only when Supabase Storage is not configured).
FILE_STORAGE_PATH=./storage/encrypted

# Encryption
# Master key for AES-256-GCM file encryption. Must be a base64-encoded
# 32-byte (256-bit) value. Never reuse this value across environments.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_MASTER_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional — only needed if/when Supabase Storage is wired in for production.
# Server-only service-role key: NEVER prefix with NEXT_PUBLIC_, never send to the browser.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=
