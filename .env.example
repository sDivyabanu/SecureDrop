# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Authentication (Auth.js / NextAuth v5)
# Secret used to sign session JWTs and CSRF tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Encryption
# Master key for AES-256-GCM file encryption. Must be a base64-encoded
# 32-byte (256-bit) value. Never reuse this value across environments.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_MASTER_KEY=

# File Storage
# "local" (default) writes encrypted objects to FILE_STORAGE_PATH on the
# local filesystem — fine for development, but does NOT persist on most
# serverless/production platforms. Set to "supabase" in production.
FILE_STORAGE_PROVIDER=local

# Used only when FILE_STORAGE_PROVIDER=local (development).
FILE_STORAGE_PATH=./storage/encrypted

# Used only when FILE_STORAGE_PROVIDER=supabase (production). The bucket
# MUST be private — SecureDrop never generates public or signed URLs; every
# download is fetched server-side with the service-role key, decrypted, and
# streamed through SecureDrop's own authorization checks.
# SUPABASE_URL is the project's API URL (https://<project-ref>.supabase.co),
# NOT the Postgres connection string above.
SUPABASE_URL=
# Server-only secret — full access to the project. NEVER prefix with
# NEXT_PUBLIC_, never send to the browser, never log.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=securedrop-files
